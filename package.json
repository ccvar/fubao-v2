    "vite": "6.4.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tauri-apps/cli": "^2.8.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0"
  }
}
