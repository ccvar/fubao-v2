{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "福宝控制台",
  "version": "0.1.24",
  "identifier": "com.ccvar.fubao.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1437",
    "beforeBuildCommand": "npm run build:engine && npm run build",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "title": "福宝控制台",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 15,
          "y": 20
        },
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "本地红包监测与参与控制台",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/fubao-engine"]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ccvar/fubao-v2-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExNEY2RTVDNDY1ODNEOTQKUldTVVBWaEdYRzVQb1RCQlZVU1dzSmFQOHRZUHJsNnVFbU5GcThUTXc4SUdOam9WYkd1YzNKQzEK"
    }
  }
}
